{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComputeChartRequest",
  "description": "Contract: Request to compute a full AstroState chart. Shared between Python engine and TypeScript API.",
  "type": "object",
  "required": ["datetime_utc", "timezone_name", "latitude", "longitude"],
  "properties": {
    "datetime_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Birth date/time in UTC (ISO 8601)."
    },
    "datetime_local": {
      "type": "string",
      "format": "date-time",
      "description": "Birth date/time in local timezone (optional, for display)."
    },
    "timezone_name": {
      "type": "string",
      "description": "IANA timezone identifier (e.g. 'Asia/Kolkata')."
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "altitude_m": {
      "type": "number",
      "default": 0
    },
    "location_name": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "rodden_rating": {
      "type": "string",
      "enum": ["AA", "A", "B", "C", "DD", "X", "XX"]
    },
    "convention_profile_id": {
      "type": "string",
      "description": "ID of the ConventionProfile to use. Defaults to 'parashari-lahiri-ws-v1'.",
      "default": "parashari-lahiri-ws-v1"
    }
  }
}
